{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-frame",
  "main": "../worker/index.js",
  "compatibility_date": "2026-09-30",
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "family-frame-photos" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
