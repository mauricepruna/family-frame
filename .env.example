# Copy to .env (git-ignored) and fill in. Loaded automatically by `just` (see justfile's
# `set dotenv-load`) for every recipe, including the terraform/ ones — so `just tf-plan` etc.
# work without exporting these by hand first.
#
# If you run `tofu`/`terraform` directly instead of through `just`, this file isn't loaded
# automatically — source it yourself first: set -a && source .env && set +a

# Cloudflare account-scoped API token, "Workers Scripts: Edit" — used by the cloudflare provider
# in terraform/ (see terraform/README.md's Prerequisites section)
CLOUDFLARE_API_TOKEN=

# R2 API token (Account-scoped, Object Read & Write, limited to the tfstate bucket) — used by
# the s3 backend in terraform/ to read/write Terraform state (see terraform/README.md's
# "Remote state" section)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
